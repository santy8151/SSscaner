# Desarrollo: copiar a .env.mvp; el comando local usa SQLite sin este archivo.
APP_ENV=development
AUTO_CREATE_SCHEMA=true
DATABASE_URL=sqlite:///./data/local/ssscanner.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Docker: reemplaza ambos marcadores por el mismo secreto; URL-encode si corresponde.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
DATABASE_URL_DOCKER=postgresql+psycopg://ssscanner:REPLACE_WITH_RANDOM_SECRET@db:5432/ssscanner
